# ── Secrets: deny by default ────────────────────────────────────────────────
# Every env variant is ignored. The only committable env file is the
# placeholder-only .env.example, re-included deliberately below.
.env
.env.*
*.env
.envrc
!.env.example

*.pem
*.key
*.p12
*.pfx
*_rsa
*_ed25519
*_ecdsa
secrets/
**/credentials.json
**/service-account*.json

# ── Dependencies ────────────────────────────────────────────────────────────
# Both forms: `node_modules/` only matches a directory, so a node_modules
# symlink would otherwise slip through.
node_modules/
node_modules
.bun/
.pnpm-store/
.yarn/
.npm/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
target/

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
.vercel/
coverage/
*.tsbuildinfo

# ── Local runtime data ──────────────────────────────────────────────────────
.data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

