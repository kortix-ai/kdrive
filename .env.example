# Volumes environment. Copy to .env (repo root) or apps/api/.env and fill in.
# Placeholders only: real values live in git-ignored .env files. Never commit them.

# Postgres (local dev DB; tests use volumes_test)
DATABASE_URL=postgresql://localhost:5432/volumes_dev

# better-auth. Generate the secret with: openssl rand -hex 32
# Outside development the server refuses to start without a private secret of 32+ characters.
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
# The WEB origin (Next rewrites /api/* to the API, so auth lives on this origin)
BETTER_AUTH_URL=http://localhost:4100
API_PORT=4101
# Interface the API listens on. Keep the loopback default unless a reverse proxy on
# another host must reach it; the web app reaches it through its /api rewrite.
API_HOST=127.0.0.1
# Where the web app's /api rewrite sends requests (the API origin)
# VOLUMES_API_ORIGIN=http://127.0.0.1:4101
# Extra origins allowed to call mutating routes, comma-separated (e.g. a staging web host)
# VOLUMES_TRUSTED_ORIGINS=

# Platinum storage (server-side only; the token never reaches the browser)
PT_API_URL=
PT_TOKEN=

# "emulated" forces the on-disk emulator; empty = platinum when PT_API_URL + PT_TOKEN are set
VOLUMES_STORAGE=
# Emulator data dir (git-ignored)
VOLUMES_DATA_DIR=.data

# Dev-only email sign-in (no password). Set to 1 on your own machine only: it works
# only with NODE_ENV=development (the dev script's default), a localhost BETTER_AUTH_URL
# and a caller on this machine. `bun run start` sets NODE_ENV=production.
VOLUMES_DEV_LOGIN=

# OAuth apps. Callback URLs: http://localhost:4100/api/auth/callback/google and .../github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated admin emails
VOLUMES_ADMIN_EMAILS=
# Default per-user quota (10 GiB); admins can raise it up to 50 GiB
VOLUMES_DEFAULT_QUOTA_BYTES=10737418240
# Workspaces one user may own (default 5; duplicates count)
VOLUMES_MAX_WORKSPACES_PER_USER=5

# AI agent access (MCP server at <BETTER_AUTH_URL>/mcp). 0 turns off /mcp, the OAuth
# discovery documents and the agent setup screens. Default 1.
VOLUMES_MCP_ENABLED=1
# Extra browser origins allowed to call /mcp, comma-separated (native clients send none)
# VOLUMES_MCP_ORIGINS=

# Tests only: the database the API test suite truncates (default volumes_test)
# VOLUMES_TEST_DATABASE_URL=postgresql://localhost:5432/volumes_test
