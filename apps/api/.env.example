# Volumes environment. Copy to .env (repo root) or apps/api/.env and fill in.
# Placeholders only: real values live in git-ignored .env files. Never commit them.

# Postgres (local dev DB; tests use volumes_test)
DATABASE_URL=postgresql://localhost:5432/volumes_dev

# better-auth. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
# The WEB origin (Next rewrites /api/* to the API, so auth lives on this origin)
BETTER_AUTH_URL=http://localhost:4100
API_PORT=4101

# Platinum storage (server-side only; the token never reaches the browser)
PT_API_URL=
PT_TOKEN=

# "emulated" forces the on-disk emulator; empty = platinum when PT_API_URL + PT_TOKEN are set
VOLUMES_STORAGE=
# Emulator data dir (git-ignored)
VOLUMES_DATA_DIR=.data

# Dev-only email sign-in (no password). Ignored when NODE_ENV=production.
VOLUMES_DEV_LOGIN=1

# OAuth apps. Callback URLs: http://localhost:4100/api/auth/callback/google and .../github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated admin emails
VOLUMES_ADMIN_EMAILS=
# Default per-user quota (10 GiB); admins can raise it up to 50 GiB
VOLUMES_DEFAULT_QUOTA_BYTES=10737418240
